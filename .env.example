# JanaKavach Website Configuration
# Set the direct universal APK download URL (e.g. GitHub Release asset or CDN)
NEXT_PUBLIC_APK_DOWNLOAD_URL=

# Release notes URL (defaults to internal /release-notes route)
NEXT_PUBLIC_RELEASE_NOTES_URL=/release-notes

# Production website domain for OpenGraph, canonical URLs, QR code and sitemap
# Set this to your actual deployed domain (e.g. https://your-project.vercel.app)
NEXT_PUBLIC_SITE_URL=
